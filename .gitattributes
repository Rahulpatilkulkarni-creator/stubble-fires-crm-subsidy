# GitHub Linguist — make the language bar reflect the code I actually wrote,
# not the large generated artifacts the pipeline emits. GitHub counts bytes of
# programming/markup files; without these lines one 5 MB generated map shows the
# repo as ~68% HTML. (GeoJSON/CSV are already ignored by Linguist as "data".)

# Interactive hotspot map: a folium/Leaflet dump generated by fire_policy.eda.
reports/hotspot_map.html    linguist-generated=true

# Executed notebooks are built by notebooks/_build_notebooks.py; most of their
# bytes are embedded base64 figures, not hand-written code — so exclude them
# from the language stats (they still render normally on GitHub).
notebooks/*.ipynb           linguist-generated=true

# Pipeline outputs — collapse their diffs too (not counted in the bar anyway).
data/**                     linguist-generated=true
